{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seemaths-home",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "arcade.seemaths.org",
      "custom_domain": true
    },
    {
      "pattern": "seemaths.org",
      "custom_domain": true
    },
    {
      "pattern": "www.seemaths.org",
      "custom_domain": true
    },
    {
      "pattern": "mathspace.seemaths.org",
      "custom_domain": true
    }
  ],
  "main": "worker.js",
  "vars": {
    "BACKEND_ORIGIN": "https://psat.seemaths.org"
  },
  "build": {
    "command": "npm run build"
  }
}
