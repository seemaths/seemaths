{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seemaths-home",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/manifest.webmanifest",
      "/service-worker.js",
      "/favicon.ico",
      "/api/assignments*",
      "/api/config",
      "/manage/*",
      "/a/*",
      "/exercises",
      "/exercises/"
    ]
  },
  "routes": [
    {
      "pattern": "player.seemaths.org",
      "custom_domain": true
    },
    {
      "pattern": "arcade.seemaths.org",
      "custom_domain": true
    },
    {
      "pattern": "seemaths.org",
      "custom_domain": true
    },
    {
      "pattern": "www.seemaths.org",
      "custom_domain": true
    },
    {
      "pattern": "mathspace.seemaths.org",
      "custom_domain": true
    }
  ],
  "main": "worker.js",
  "vars": {
    "STATIC_QUODES": "true",
    "BACKEND_ORIGIN": "https://psat.seemaths.org",
    "ASSIGNMENTS_ORIGIN": "https://seemaths-assignments.vercel.app"
  },
  "build": {
    "command": "npm run build"
  },
  "compatibility_flags": [
    "assets_navigation_has_no_effect"
  ]
}
